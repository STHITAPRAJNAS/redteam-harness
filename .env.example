# rtharness environment — copy to .env, fill in only what you need.
# The harness runs fully WITHOUT any of these (deterministic engine).
# These keys power the OPTIONAL attacker/judge models only — never the target.

# Attacker / judge model credentials (referenced by `api_key_env` in your config)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Credential for the TARGET agent under test, if it requires one
# (referenced by `api_key_env` in the target config, forwarded as a bearer token)
# TARGET_API_TOKEN=...

# Web service bind (Docker CMD already sets 0.0.0.0:8900)
# RTHARNESS_HOST=127.0.0.1
# RTHARNESS_PORT=8900
